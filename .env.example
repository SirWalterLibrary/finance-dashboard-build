# Copy to .env on the SERVER (docker compose reads it). Never commit .env.
# Categorizer: your system-one model endpoint on the Nobara PC (from the server, NOT localhost)
LLM_URL=http://192.168.1.12:11434/v1/systemone
LLM_MODEL=d3:9b
LLM_MIN_CONFIDENCE=0
# Optional: free-text explanations (standard Ollama chat model)
OLLAMA_URL=http://192.168.1.12:11434
EXPLAIN_MODEL=gemma4:26b
COOKIE_SECURE=1
